# Copy to backend/.env (local) or pass to Docker (--env-file .env). Never commit real values.
GEMINI_API_KEY=your-gemini-api-key
ADMIN_PASSWORD=choose-a-long-unique-password
# Any long random string, e.g. `openssl rand -hex 32`
ADMIN_TOKEN=replace-with-random-hex
# Only needed if the frontend is hosted on a different domain than the backend:
# CORS_ORIGINS=https://tutor.example.com
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-3.8-live
