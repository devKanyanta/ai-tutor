# Copy to backend/.env (local) or pass to Docker (--env-file .env). Never commit real values.
GEMINI_API_KEY=your-gemini-api-key
# PostgreSQL. Local default is the socket as your OS user:  postgresql+psycopg:///ai_tutor
# (docker compose builds this itself from POSTGRES_PASSWORD)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_tutor
POSTGRES_PASSWORD=choose-a-database-password
ADMIN_PASSWORD=choose-a-long-unique-password
# Any long random string, e.g. `openssl rand -hex 32`
ADMIN_TOKEN=replace-with-random-hex
# Only needed if the frontend is hosted on a different domain than the backend:
# CORS_ORIGINS=https://tutor.example.com
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Free-trial limits (defaults shown)
# TRIAL_MAX_TUTORS=2
# TRIAL_MAX_UPLOAD_MB=5
# TRIAL_DAILY_TURNS=40
# TRIAL_DAILY_VOICE_MINUTES=10
